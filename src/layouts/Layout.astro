---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="description" content="Blog personal de Esteban Girón Herrera" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Blog de Esteban Girón Herrera</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/">Inicio</a>
				<a href="/blog">Blog</a>
				<a href="/about">Sobre mí</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<p>© {new Date().getFullYear()} Esteban Girón Herrera</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}

	html {
		font-family: system-ui, sans-serif;
		background: #13151a;
		color: white;
	}

	nav {
		display: flex;
		gap: 1.5rem;
		padding: 1.5rem;
	}

	nav a {
		color: white;
		text-decoration: none;
		font-weight: 500;
	}

	nav a:hover {
		text-decoration: underline;
	}

	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1.5rem 3rem;
	}

	footer {
		text-align: center;
		padding: 2rem;
		opacity: 0.7;
		font-size: 0.875rem;
	}
</style>