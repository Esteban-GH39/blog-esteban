---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
interface Props {
	title: string;
	description?: string;
	image?: string;
}
const { title,
	description = "Blog personal de Esteban Girón Herrera - notas de aprendizaje y devlogs de proyectos.",
	image = "/public/banner-esteban.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Blog de Esteban Girón Herrera</title>

		<meta property="og:type" content="article" />
		<meta property="og:title" content={`${title} | Blog de Esteban Girón Herrera`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:url" content={Astro.url} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | Blog de Esteban Girón Herrera`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />

		<ClientRouter />
	</head>
	<body class="bg-base text-ink min-h-screen flex flex-col font-body">
		<header class="border-b border-border">
			<nav class="max-w-3xl mx-auto flex gap-6 px-6 py-6">
				<a href="/" class="font-display font-medium hover:text-accent-light transition-colors">Inicio</a>
				<a href="/blog" class="font-display font-medium hover:text-accent-light transition-colors">Blog</a>
				<a href="/about" class="font-display font-medium hover:text-accent-light transition-colors">Sobre mí</a>
			</nav>
		</header>

		<main class="max-w-3xl mx-auto px-6 py-12 flex-1 w-full">
			<slot />
		</main>

		<footer class="text-center py-8 text-sm text-ink-faint border-t border-border">
			<p>© {new Date().getFullYear()} Esteban Girón Herrera</p>
		</footer>
	</body>
</html>