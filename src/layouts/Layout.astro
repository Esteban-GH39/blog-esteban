---
import "../styles/global.css";
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="description" content="Blog personal de Esteban Girón Herrera" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Blog de Esteban Girón Herrera</title>
	</head>
	<body class="bg-neutral-950 text-white min-h-screen flex flex-col">
		<header class="border-b border-neutral-800">
			<nav class="max-w-3xl mx-auto flex gap-6 px-6 py-6">
				<a href="/" class="font-medium hover:text-violet-400 transition-colors">Inicio</a>
				<a href="/blog" class="font-medium hover:text-violet-400 transition-colors">Blog</a>
				<a href="/about" class="font-medium hover:text-violet-400 transition-colors">Sobre mí</a>
			</nav>
		</header>
		<main class="max-w-3xl mx-auto px-6 py-12 flex-1 w-full">
			<slot />
		</main>
		<footer class="text-center py-8 text-sm text-neutral-500 border-t border-neutral-800">
			<p>© {new Date().getFullYear()} Esteban Girón Herrera</p>
		</footer>
	</body>
</html>