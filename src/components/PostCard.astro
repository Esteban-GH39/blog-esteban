---
interface Props {
    title: string;
    description: string;
    date: Date;
    slug: string;
    category: string;
	image: {
		name: string;
		url: string;
	}
}

const { title, description, date, slug, category, image } = Astro.props;
const categoryStyles: Record<string, string> = {
    devlog: "bg-accent/10 text-accent-light border-accent/30",
	notas: "bg-sky-500/10 text-sky-400 border-sky-500/30",
};
---

<a	
    href={`/blog/${slug}`}
	class="block p-6 rounded-xl border border-border bg-surface hover:border-accent transition-colors"
>
	{image?.url && (
		<img src={image.url} alt={title} class="w-full h-48 object-cover rounded-lg mb-4" />
	)}
	<span class={`inline-block text-xs font-medium px-2 py-1 rounded-full border mb-3 ${categoryStyles[category] ?? "bg-neutral-800 text-neutral-400 border-neutral-700"}`}>
		{category}
	</span>
	<h2 class="font-display text-xl font-semibold mb-2">{title}</h2>
	<p class="text-ink-muted mb-3">{description}</p>
	<time class="text-sm text-ink-faint">{date.toLocaleDateString("es-ES")}</time>
</a>