---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { client } from "../lib/content-island";

interface Post {
	id: string;
	title: string;
	description: string;
	date: string;
	category: string;
	slug: string;
	content: string;
	image: {
		name: string;
		url: string;
	}
}

const posts = await client.getContentList<Post>({ contentType: "Post" });
const ultimosPosts = posts
	.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
	.slice(0, 3);
---

<Layout title="Inicio">
	<h1 class="text-4xl font-bold mb-3">Blog de Esteban Girón Herrera</h1>
	<p class="text-neutral-400 mb-10">Notas de aprendizaje y devlogs de mis proyectos, como TableMaster.</p>

	{ultimosPosts.map((post) => (
		<PostCard
		title={post.title}
		description={post.description}
		date={new Date(post.date)}
		slug={post.slug}
		category={post.category}
		image={post.image}
		/>
	))}

	<a href="/blog" class="text-violet-400 hover:text-violet-300 transition-colors">Ver todos los posts →</a>
</Layout>