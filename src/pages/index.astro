---
// FENCE: Es lo que corre en el server
import PostCard from "../components/PostCard.astro";

const postsDeEjemplo = [
  	{ title: "Construyendo TableMaster", description: "Cómo diseñé la arquitectura", date: new Date(), slug: "construyendo-tablemaster" },
  	{ title: "Mi primer post", description: "Bienvenida al blog", date: new Date(), slug: "mi-primer-post" },
];
---

<html lang="es">
  	<head>
    	<meta charset="utf-8" />
    	<title>Blog de Esteban</title>
  	</head>
  	<body>
   		<h1>Blog de Esteban</h1>
    	{postsDeEjemplo.map((post) => <PostCard {...post} />)}
  	</body>
</html>