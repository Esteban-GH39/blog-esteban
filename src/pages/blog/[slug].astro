---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { client } from "../../lib/content-island";

interface Post {
    id: string;
	title: string;
	description: string;
	date: string;
	category: string;
	slug: string;
	content: string;
}

export async function getStaticPaths() {
    const posts = await client.getContentList<Post>({ contentType: "Post" });
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props as { post: Post };
---

<Layout title={post.title}>
	<article>
		<h1 class="text-4xl font-bold mb-2">{post.title}</h1>
		<time class="text-sm text-neutral-500">{new Date(post.date).toLocaleDateString("es-ES")}</time>
		<p class="text-neutral-400 italic mt-4 mb-8">{post.description}</p>
		<div class="prose prose-invert max-w-none" set:html={post.content} />
	</article>
</Layout>