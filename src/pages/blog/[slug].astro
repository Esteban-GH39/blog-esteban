---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { client } from "../../lib/content-island";
import type { string } from "astro:schema";

interface Post {
    id: string;
	title: string;
	description: string;
	date: string;
	category: string;
	slug: string;
	content: string;
	image: {
		name: string;
		url: string;
	}
}

export async function getStaticPaths() {
    const posts = await client.getContentList<Post>({ contentType: "Post" });
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props as { post: Post };
---

<Layout title={post.title} description={post.description} image={post.image?.url}>
	<article>
		{post.image?.url && (
			<img src={post.image.url} alt={post.title} class="w-full h-64 object-cover rounded-xl mb-8" />
		)}
		<h1 class="font-display text-4xl font-bold mb-2">{post.title}</h1>
		<time class="text-sm text-ink-faint">{new Date(post.date).toLocaleDateString("es-ES")}</time>
		<p class="text-ink-muted italic mt-4 mb-8">{post.description}</p>
		<div class="prose prose-invert max-w-none" set:html={post.content} />
	</article>
</Layout>