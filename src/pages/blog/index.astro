---
import Layout from "../../layouts/Layout.astro";
import BlogSearch from "../../components/BlogSearch.tsx";
import { client } from "../../lib/content-island";

interface Post {
	id: string;
	title: string;
	description: string;
	date: string;
	category: string;
	slug: string;
	content: string;
}

const posts = await client.getContentList<Post>({ contentType: "Post" });
const postsOrdenados = posts.sort(
	(a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);
---

<Layout title="Blog">
	<h1 class="text-4xl font-bold mb-10">Todos los posts</h1>
	<BlogSearch posts={postsOrdenados} client:load />
</Layout>